# ===== Secrets — never commit these =====
.env
.env.*
*.pem
*.key

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ===== Virtual environments =====
venv/
env/
ENV/
.venv/
vehicle/

# ===== Conda (you're using 'vehicle' env) =====
# Not usually inside the repo, but just in case:
*.conda/

# ===== Project-generated artifacts =====
artifact/
logs/
*.log

# ===== Model / data files (usually large, regenerated by pipeline) =====
*.pkl
*.npy
*.csv
!config/*.yaml
!config/*.csv

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== IDE / editor =====
.vscode/
.idea/
*.swp

# ===== OS junk =====
.DS_Store
Thumbs.db

# ===== DVC (if you're using it — saw it in your VS Code sidebar) =====
# DVC tracks large files separately; don't ignore .dvc files themselves,
# but ignore the actual data DVC manages if it lives in these folders:
# /data
# /artifact  (already covered above)

# ===== Test / debug scripts you don't want tracked =====
test_mongo.py
demo.py
template.py
pyproject.toml
.dockerignore
.project-root
notebook/